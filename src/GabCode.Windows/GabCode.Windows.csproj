<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsTerminalAssetRoot>$(MSBuildThisFileDirectory)..\..\third_party\microsoft-terminal\v1.24.11911.0\win-x64</WindowsTerminalAssetRoot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GabCode.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Terminal.Wpf">
      <HintPath>$(WindowsTerminalAssetRoot)\Microsoft.Terminal.Wpf.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="$(WindowsTerminalAssetRoot)\Microsoft.Terminal.Wpf.dll"
             Link="Microsoft.Terminal.Wpf.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(WindowsTerminalAssetRoot)\Microsoft.Terminal.Control.dll"
             Link="Microsoft.Terminal.Control.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateWindowsTerminalAssets" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(WindowsTerminalAssetRoot)\Microsoft.Terminal.Wpf.dll')"
           Text="Missing approved Windows Terminal WPF asset. Run: pwsh -NoProfile -File eng/windows-terminal/Build-WpfControl.ps1 -Verify" />
    <Error Condition="!Exists('$(WindowsTerminalAssetRoot)\Microsoft.Terminal.Control.dll')"
           Text="Missing approved Windows Terminal native asset. Run: pwsh -NoProfile -File eng/windows-terminal/Build-WpfControl.ps1 -Verify" />
  </Target>

</Project>
