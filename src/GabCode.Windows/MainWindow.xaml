<Window x:Class="GabCode.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="gabCode"
        AutomationProperties.Name="gabCode"
        Height="820"
        Width="1220"
        MinHeight="640"
        MinWidth="900"
        Background="#151515">
    <Window.Resources>
        <ControlTemplate x:Key="DarkButtonTemplate" TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="2">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#3A3D49" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#6B8FBD" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#252832" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="Background" Value="#30323B" />
            <Setter Property="BorderBrush" Value="#454854" />
            <Setter Property="Template" Value="{StaticResource DarkButtonTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3A3D49" /><Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#6B8FBD" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#252832" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#202126" BorderBrush="#383A42" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Menu AutomationProperties.Name="Application menu">
                    <MenuItem x:Name="FileMenuItem" Header="_File" AutomationProperties.Name="File">
                        <MenuItem Header="_Open Workspace…" Click="OpenWorkspaceButton_Click" AutomationProperties.Name="Open workspace" />
                        <MenuItem Header="_Create Workspace…" Click="CreateWorkspaceButton_Click" AutomationProperties.Name="Create workspace" />
                        <Separator />
                        <MenuItem Header="_Settings…" Click="OpenTerminalFontSettings_Click" AutomationProperties.Name="Open terminal font settings" />
                    </MenuItem>
                    <MenuItem Header="_View" AutomationProperties.Name="View">
                        <MenuItem Header="Move Sidebar _Right" Click="MoveSidebarRight_Click" AutomationProperties.Name="Move sidebar right" />
                        <MenuItem Header="Move Sidebar _Left" Click="MoveSidebarLeft_Click" AutomationProperties.Name="Move sidebar left" />
                        <MenuItem Header="_Refresh Worktrees" InputGestureText="F5" Click="RefreshWorktrees_Click" AutomationProperties.Name="Refresh worktrees" />
                    </MenuItem>
                </Menu>
                <Grid Grid.Row="1" Margin="12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#F4F4F5" Text="gabCode" />
                <TextBlock x:Name="WorktreePathText" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Foreground="#A9ABB5" TextTrimming="CharacterEllipsis" ToolTip="Project folder" AutomationProperties.Name="Project folder" />
                <Button x:Name="SwapTerminalsButton" Grid.Column="2" Padding="12,5" VerticalAlignment="Center" Background="#30323B" Foreground="#E5E7EB" BorderBrush="#454854" Click="SwapTerminalsButton_Click" Content="Swap terminals" ToolTip="Move the lower terminal to the main region" AutomationProperties.Name="Swap the main and lower terminal regions" />
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="TerminalWorkspace" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="270" MinWidth="190" MaxWidth="420" /><ColumnDefinition Width="5" /><ColumnDefinition x:Name="TerminalColumn" Width="*" MinWidth="520" /></Grid.ColumnDefinitions>
            <Border x:Name="WorktreeSidebar" Background="#1D1E24" BorderBrush="#383A42" BorderThickness="0,0,1,0" Padding="12" AutomationProperties.Name="Worktrees sidebar">
                <DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="Worktrees" FontSize="16" FontWeight="SemiBold" Foreground="#F4F4F5" VerticalAlignment="Center" /><Button x:Name="RefreshWorktreesButton" Margin="12,0,0,0" Padding="8,4" Background="#30323B" Foreground="#E5E7EB" BorderBrush="#454854" Content="↻" ToolTip="Refresh worktrees" Click="RefreshWorktrees_Click" AutomationProperties.Name="Refresh worktrees" /><Button x:Name="CancelRefreshButton" Background="#30323B" Foreground="White" Margin="8,0,0,0" Content="Cancel" Click="CancelRefresh_Click" Visibility="Collapsed" AutomationProperties.Name="Cancel worktree refresh" /></StackPanel><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="RefreshStatusText" Margin="0,0,0,4" Foreground="White" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><WrapPanel><Button x:Name="RetryCleanupButton" Content="Retry cleanup" Margin="0,0,8,4" Visibility="Collapsed" Click="RetryRetainedWorktreeCleanup_Click" AutomationProperties.Name="Retry cleanup" /><Button x:Name="OpenRetainedFolderButton" Content="Open folder" Margin="0,0,0,4" Visibility="Collapsed" Click="OpenRetainedFolder_Click" AutomationProperties.Name="Open retained worktree folder" /></WrapPanel></StackPanel><ListBox x:Name="WorktreeList" Background="#1D1E24" Foreground="#E5E7EB" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="WorktreeList_SelectionChanged" PreviewMouseRightButtonDown="WorktreeList_PreviewMouseRightButtonDown" ContextMenuOpening="WorktreeList_ContextMenuOpening" AutomationProperties.Name="Worktrees and orphaned terminals">
                    <ListBox.Resources>
                        <ContextMenu x:Key="WorktreeContextMenu" x:Shared="False" AutomationProperties.Name="Worktree actions">
                            <MenuItem Header="Close Workspace" Click="CloseWorkspace_Click" AutomationProperties.Name="Close selected workspace terminals" />
                            <MenuItem Header="Open in VS Code" Click="OpenWorktreeInCode_Click" AutomationProperties.Name="Open worktree in VS Code" />
                            <MenuItem Header="Reveal in Explorer" Click="RevealWorktree_Click" AutomationProperties.Name="Reveal worktree in Explorer" />
                            <Separator />
                            <MenuItem Header="Create worktree from main" Click="CreateWorktreeFromMain_Click" AutomationProperties.Name="Create worktree from main" />
                            <MenuItem Header="Create worktree from selected branch" Click="CreateWorktreeFromSelectedBranch_Click" AutomationProperties.Name="Create worktree from selected branch" />
                            <MenuItem Header="Create worktree from existing branch" Click="CreateWorktreeFromExistingBranch_Click" AutomationProperties.Name="Create worktree from existing branch" />
                            <Separator />
                            <MenuItem Header="Choose Markdown…" Click="AssignMarkdown_Click" AutomationProperties.Name="Choose worktree Markdown" />
                            <MenuItem Header="Open Markdown" Click="OpenMarkdown_Click" AutomationProperties.Name="Open worktree Markdown" />
                            <MenuItem Header="Remove Markdown" Click="RemoveMarkdown_Click" AutomationProperties.Name="Remove worktree Markdown" />
                            <MenuItem Header="Add GitHub issue…" Click="AssignIssue_Click" AutomationProperties.Name="Add worktree GitHub issue" />
                            <MenuItem Header="Open issue" Click="OpenIssue_Click" AutomationProperties.Name="Open worktree GitHub issue" />
                            <MenuItem Header="Remove issue" Click="RemoveIssue_Click" AutomationProperties.Name="Remove worktree GitHub issue" />
                            <Separator />
                            <MenuItem Header="Delete worktree" Click="DeleteWorktree_Click" AutomationProperties.Name="Delete worktree" />
                        </ContextMenu>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="ContextMenu" Value="{StaticResource WorktreeContextMenu}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListBox.Resources>
                </ListBox></DockPanel>
            </Border>
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#383A42" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize worktree sidebar and terminal area" />
            <Grid x:Name="TerminalGrid" Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="2*" MinHeight="250" /><RowDefinition Height="5" /><RowDefinition Height="*" MinHeight="190" /></Grid.RowDefinitions>
                <Grid x:Name="WorktreeReferencesBar" Margin="12,8,12,4" AutomationProperties.Name="Worktree references">
                        <Grid.Resources><Style TargetType="Button"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#E5E7EB" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Padding" Value="8,3" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Template" Value="{StaticResource DarkButtonTemplate}" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#30323B" /><Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="Transparent" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#252832" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger></Style.Triggers></Style></Grid.Resources>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="MarkdownReferenceButton" Content="▣  Markdown ▾" Click="ReferenceActions_Click" AutomationProperties.Name="Markdown reference actions"><Button.ContextMenu><ContextMenu><MenuItem Header="Choose or Replace Markdown…" Click="AssignMarkdown_Click" /><MenuItem Header="Open Markdown" Click="OpenMarkdown_Click" /><MenuItem Header="Remove Markdown" Click="RemoveMarkdown_Click" /></ContextMenu></Button.ContextMenu></Button>
                        <TextBlock x:Name="MarkdownReferenceText" Grid.Column="1" Visibility="Collapsed" Margin="6,0,18,0" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="IssueReferenceButton" Grid.Column="2" Content="⌁  GitHub issue ▾" Click="ReferenceActions_Click" AutomationProperties.Name="Issue reference actions"><Button.ContextMenu><ContextMenu><MenuItem Header="Add issue or Replace…" Click="AssignIssue_Click" /><MenuItem Header="Open issue" Click="OpenIssue_Click" /><MenuItem Header="Remove issue" Click="RemoveIssue_Click" /></ContextMenu></Button.ContextMenu></Button>
                        <TextBlock x:Name="IssueReferenceText" Grid.Column="3" Visibility="Collapsed" Margin="6,0,0,0" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                </Grid>
                <Border Grid.Row="1" Margin="12,3,12,3" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="3"><ContentControl x:Name="MainTerminalRegion" AutomationProperties.Name="Main terminal region" /></Border>
                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#555555" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize main and bottom terminal regions" />
                <Border Grid.Row="3" Margin="12,3,12,12" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="3"><ContentControl x:Name="BottomTerminalRegion" AutomationProperties.Name="Bottom terminal region" /></Border>
                <Border x:Name="ClosedWorkspaceSurface" Grid.RowSpan="4" Margin="12" Padding="28" Background="#242424" BorderBrush="#5A5A5A" BorderThickness="1" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="White" Text="Workspace closed" AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock x:Name="ClosedWorkspaceMessage" Margin="0,12,0,16" Foreground="#D0D0D0" TextWrapping="Wrap" />
                        <Button x:Name="OpenClosedWorkspaceButton" HorizontalAlignment="Left" Padding="12,6" Content="Open Workspace" Click="OpenClosedWorkspaceButton_Click" AutomationProperties.Name="Open closed workspace" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="EmptyProjectSurface" Grid.Row="1" Margin="24" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680" Background="#242424" BorderBrush="#5A5A5A" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="EmptyProjectHeading" FontSize="22" FontWeight="SemiBold" Foreground="White" Text="Open a gabCode project" AutomationProperties.LiveSetting="Assertive" />
                <TextBlock x:Name="EmptyProjectMessage" Margin="0,12,0,16" Foreground="#D0D0D0" TextWrapping="Wrap" Text="Open a workspace file or create one for an existing Git folder." AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="OpenWorkspaceButton" Padding="12,6" Content="Open Workspace…" Click="OpenWorkspaceButton_Click" AutomationProperties.Name="Open workspace" />
                    <Button x:Name="CreateWorkspaceButton" Margin="8,0,0,0" Padding="12,6" Content="Create Workspace from Git Folder…" Click="CreateWorkspaceButton_Click" AutomationProperties.Name="Create workspace from Git folder" />
                    <Button x:Name="CancelDiscoveryButton" Margin="8,0,0,0" Padding="12,6" Content="Cancel" Click="CancelDiscoveryButton_Click" Visibility="Collapsed" AutomationProperties.Name="Cancel Git repository discovery" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="WorktreeFailureSurface" Grid.Row="1" Margin="24" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680" Background="#242424" BorderBrush="#5A5A5A" BorderThickness="1" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="WorktreeFailureHeading" FontSize="22" FontWeight="SemiBold" Foreground="White" Text="Workspace could not be opened" AutomationProperties.LiveSetting="Assertive" />
                <TextBlock x:Name="WorktreeFailureMessage" Margin="0,12,0,0" Foreground="#D0D0D0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
