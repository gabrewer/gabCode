<Window x:Class="GabCode.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="gabCode"
        AutomationProperties.Name="gabCode"
        Height="820"
        Width="1220"
        MinHeight="640"
        MinWidth="900"
        Background="#151515">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="12,6" Background="#242424" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Menu Background="#242424" Foreground="White" AutomationProperties.Name="Application menu">
                    <Menu.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#242424" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="White" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#3A3A3A" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                        <Style TargetType="MenuItem">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Style>
                    </Menu.Resources>
                    <MenuItem x:Name="FileMenuItem" Header="_File" Background="#242424" Foreground="White" Loaded="FileMenuItem_Loaded" AutomationProperties.Name="File">
                        <MenuItem Header="_Open Workspace…" Background="#242424" Foreground="White" Click="OpenWorkspaceButton_Click" AutomationProperties.Name="Open workspace" />
                        <MenuItem Header="_Create Workspace…" Background="#242424" Foreground="White" Click="CreateWorkspaceButton_Click" AutomationProperties.Name="Create workspace" />
                    </MenuItem>
                    <MenuItem Header="_View" Background="#242424" Foreground="White" AutomationProperties.Name="View">
                        <MenuItem Header="Move Sidebar _Right" Click="MoveSidebarRight_Click" AutomationProperties.Name="Move sidebar right" />
                        <MenuItem Header="Move Sidebar _Left" Click="MoveSidebarLeft_Click" AutomationProperties.Name="Move sidebar left" />
                        <MenuItem Header="_Refresh Worktrees" InputGestureText="F5" Click="RefreshWorktrees_Click" AutomationProperties.Name="Refresh worktrees" />
                    </MenuItem>
                </Menu>
                <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="White" Text="gabCode" />
                <TextBlock x:Name="WorktreePathText" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Foreground="#C8C8C8" TextTrimming="CharacterEllipsis" ToolTip="Project folder" AutomationProperties.Name="Project folder" />
                <Button x:Name="SwapTerminalsButton" Grid.Column="2" Padding="10,4" VerticalAlignment="Center" Click="SwapTerminalsButton_Click" Content="Swap terminals" ToolTip="Move the lower terminal to the main region" AutomationProperties.Name="Swap the main and lower terminal regions" />
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="TerminalWorkspace" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="250" /><ColumnDefinition x:Name="TerminalColumn" Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="WorktreeSidebar" Background="Black" BorderBrush="#4A4A4A" BorderThickness="0,0,1,0" Padding="8" AutomationProperties.Name="Worktrees sidebar">
                <DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"><Button x:Name="RefreshWorktreesButton" Background="Black" Foreground="White" Content="Refresh Worktrees" Click="RefreshWorktrees_Click" AutomationProperties.Name="Refresh worktrees" /><Button x:Name="CancelRefreshButton" Background="Black" Foreground="White" Margin="8,0,0,0" Content="Cancel" Click="CancelRefresh_Click" Visibility="Collapsed" AutomationProperties.Name="Cancel worktree refresh" /></StackPanel><TextBlock x:Name="RefreshStatusText" DockPanel.Dock="Top" Foreground="White" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><ListBox x:Name="WorktreeList" Background="Black" Foreground="White" SelectionChanged="WorktreeList_SelectionChanged" AutomationProperties.Name="Worktrees and orphaned terminals" /></DockPanel>
            </Border>
            <Grid x:Name="TerminalGrid" Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="2*" MinHeight="250" /><RowDefinition Height="5" /><RowDefinition Height="*" MinHeight="190" /></Grid.RowDefinitions>
                <Border Margin="12,12,12,3" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="3"><ContentControl x:Name="MainTerminalRegion" AutomationProperties.Name="Main terminal region" /></Border>
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#555555" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize main and bottom terminal regions" />
                <Border Grid.Row="2" Margin="12,3,12,12" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="3"><ContentControl x:Name="BottomTerminalRegion" AutomationProperties.Name="Bottom terminal region" /></Border>
            </Grid>
        </Grid>

        <Border x:Name="EmptyProjectSurface" Grid.Row="1" Margin="24" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680" Background="#242424" BorderBrush="#5A5A5A" BorderThickness="1">
            <StackPanel>
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="White" Text="Open a gabCode project" />
                <TextBlock x:Name="EmptyProjectMessage" Margin="0,12,0,16" Foreground="#D0D0D0" TextWrapping="Wrap" Text="Open a workspace file or create one for an existing Git folder." AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="OpenWorkspaceButton" Padding="12,6" Content="Open Workspace…" Click="OpenWorkspaceButton_Click" AutomationProperties.Name="Open workspace" />
                    <Button x:Name="CreateWorkspaceButton" Margin="8,0,0,0" Padding="12,6" Content="Create Workspace from Git Folder…" Click="CreateWorkspaceButton_Click" AutomationProperties.Name="Create workspace from Git folder" />
                    <Button x:Name="CancelDiscoveryButton" Margin="8,0,0,0" Padding="12,6" Content="Cancel" Click="CancelDiscoveryButton_Click" Visibility="Collapsed" AutomationProperties.Name="Cancel Git repository discovery" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="WorktreeFailureSurface" Grid.Row="1" Margin="24" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680" Background="#242424" BorderBrush="#5A5A5A" BorderThickness="1" Visibility="Collapsed">
            <StackPanel>
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="White" Text="Project unavailable" />
                <TextBlock x:Name="WorktreeFailureMessage" Margin="0,12,0,0" Foreground="#D0D0D0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
