<Window x:Class="GabCode.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="gabCode"
        AutomationProperties.Name="gabCode"
        Height="820"
        Width="1220"
        MinHeight="640"
        MinWidth="900"
        Background="#151515">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="18,13"
                Background="#242424"
                BorderBrush="#3A3A3A"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="gabCode" />
                    <TextBlock x:Name="WorktreePathText"
                               Margin="0,4,0,0"
                               Foreground="#C8C8C8"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="Controlled terminal working directory" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="PiMainSelector"
                                Padding="14,7"
                                Margin="0,0,8,0"
                                Click="PiMainSelector_Click"
                                Content="Pi in main"
                                AutomationProperties.Name="Show Pi in the main terminal region" />
                        <Button x:Name="CommandsMainSelector"
                                Padding="14,7"
                                Click="CommandsMainSelector_Click"
                                Content="Commands in main"
                                AutomationProperties.Name="Show Commands in the main terminal region" />
                    </StackPanel>
                    <TextBlock x:Name="TerminalLifecycleStatus"
                               Margin="0,7,0,0"
                               HorizontalAlignment="Right"
                               Foreground="White"
                               Text="Terminal lifecycle: not started"
                               AutomationProperties.Name="Terminal lifecycle: not started"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="TerminalWorkspace" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="250" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" MinHeight="190" />
            </Grid.RowDefinitions>

            <Border Margin="12,12,12,3"
                    BorderBrush="#4A4A4A"
                    BorderThickness="1"
                    CornerRadius="3">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="10,7" Background="#303030">
                        <TextBlock x:Name="MainRegionLabel"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="Main terminal — Pi"
                                   AutomationProperties.Name="Main terminal region label" />
                    </Border>
                    <ContentControl x:Name="MainTerminalRegion"
                                    AutomationProperties.Name="Main terminal region" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          Background="#555555"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          AutomationProperties.Name="Resize main and bottom terminal regions" />

            <Border Grid.Row="2"
                    Margin="12,3,12,12"
                    BorderBrush="#4A4A4A"
                    BorderThickness="1"
                    CornerRadius="3">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="10,7" Background="#303030">
                        <TextBlock x:Name="BottomRegionLabel"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="Bottom terminal — Commands"
                                   AutomationProperties.Name="Bottom terminal region label" />
                    </Border>
                    <ContentControl x:Name="BottomTerminalRegion"
                                    AutomationProperties.Name="Bottom terminal region" />
                </DockPanel>
            </Border>
        </Grid>

        <Border x:Name="WorktreeFailureSurface"
                Grid.Row="1"
                Margin="24"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="680"
                Background="#242424"
                BorderBrush="#5A5A5A"
                BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="Terminal directory unavailable" />
                <TextBlock x:Name="WorktreeFailureMessage"
                           Margin="0,12,0,0"
                           Foreground="#D0D0D0"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
