+    }
+    if (id != _lastHyperlinkId || interval != _hoveredInterval)
+    {
+        _lastHyperlinkId = id;
+        _hoveredInterval = interval;
+        _renderer->UpdateHyperlinkHoveredId(id);
+        _renderer->UpdateLastHoveredInterval(interval);
