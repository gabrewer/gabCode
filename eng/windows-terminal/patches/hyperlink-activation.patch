+void HwndTerminal::_UpdateHoveredLink()
+{
+    uint16_t id = 0;
+    decltype(_hoveredInterval) interval;
+    const auto viewport = _terminal->GetViewport();
+    if (_hoveredCell && _hoveredCell->x >= 0 && _hoveredCell->y >= 0 && _hoveredCell->x < viewport.Width() && _hoveredCell->y < viewport.Height())
