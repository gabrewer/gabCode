{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gabrewer/gabCode/eng/release/preview-evidence.schema.json",
  "title": "gabCode prepared preview artifact evidence",
  "description": "Versioned, transport-independent evidence for one locally prepared unsigned preview artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platform",
    "version",
    "sourceCommit",
    "artifact",
    "toolchain",
    "verification"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "platform": {
      "enum": [
        "windows",
        "macos"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+-preview\\.[1-9]\\d*$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidenceFileName": {
      "type": "string"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileName",
        "bytes",
        "sha256"
      ],
      "properties": {
        "fileName": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operatingSystem",
        "architecture",
        "buildTool"
      ],
      "properties": {
        "operatingSystem": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "buildTool": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checks",
        "completedAtUtc"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "platform": {
            "const": "windows"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/windows"
      }
    },
    {
      "if": {
        "properties": {
          "platform": {
            "const": "macos"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/macos"
      }
    }
  ],
  "$defs": {
    "windows": {
      "type": "object",
      "required": [
        "evidenceFileName"
      ],
      "properties": {
        "platform": {
          "const": "windows"
        },
        "evidenceFileName": {
          "pattern": "^gabCode-\\d+\\.\\d+\\.\\d+-preview\\.[1-9]\\d*-windows-x64\\.evidence\\.json$"
        },
        "artifact": {
          "properties": {
            "fileName": {
              "pattern": "^gabCode-\\d+\\.\\d+\\.\\d+-preview\\.[1-9]\\d*-windows-x64\\.msi$"
            }
          }
        }
      }
    },
    "macos": {
      "type": "object",
      "required": [
        "evidenceFileName"
      ],
      "properties": {
        "platform": {
          "const": "macos"
        },
        "evidenceFileName": {
          "pattern": "^gabCode-\\d+\\.\\d+\\.\\d+-preview\\.[1-9]\\d*-macos-arm64\\.evidence\\.json$"
        },
        "artifact": {
          "properties": {
            "fileName": {
              "pattern": "^gabCode-\\d+\\.\\d+\\.\\d+-preview\\.[1-9]\\d*-macos-arm64\\.dmg$"
            }
          }
        }
      }
    }
  }
}
